{
  "name": "aisb",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3333",
    "build": "next build",
    "start": "next start -p 3333",
    "lint": "next lint --dir src --dir tests --file playwright.config.ts --file vitest.config.mts",
    "preview": "serve out --config ../serve.json --listen tcp://127.0.0.1:4173 --no-clipboard",
    "typecheck": "tsc --noEmit --incremental false && tsc --project tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:hero": "playwright test hero-",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "hls.js": "1.7.2",
    "next": "14.1.0",
    "posthog-js": "^1.396.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "14.1.0",
    "postcss": "^8.0.0",
    "serve": "14.2.6",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0",
    "vitest": "4.1.11"
  }
}
