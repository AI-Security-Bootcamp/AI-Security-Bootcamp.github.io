{
  "name": "aisb",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3333",
    "build": "next build",
    "start": "next start -p 3333",
    "lint": "eslint src tests playwright.config.ts vitest.config.mts",
    "preview": "serve out --config ../serve.json --listen tcp://127.0.0.1:4173 --no-clipboard",
    "typecheck": "next typegen && tsc --noEmit --incremental false && tsc --project tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:hero": "playwright test hero-",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "hls.js": "1.7.2",
    "next": "16.4.2",
    "posthog-js": "^1.396.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "fast-glob": "file:tools/next-eslint-glob",
    "postcss": "^8.0.0",
    "serve": "14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    },
    "serve": {
      "compression": "^1.8.2"
    }
  }
}
