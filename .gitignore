# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.idea/
/projects/
/dmarc/

# local agent and scratch data
/.claude/settings.local.json
/snapshots/
/tmp/

# Local Raspberry Pi SSH keypair
/codex_rpi_ed25519
/codex_rpi_ed25519.pub

# Generated paper badges and conference print exports (keep source files)
/print/guest-badges/*.pdf
/print/guest-badges/*.png
/print/guest-badges/*.svg
/print/conference-pack/*.pdf
/print/conference-pack/*.png
/print/conference-pack/*-a4.svg

# Badge previews belong in hardware/{aisb,m3}/out/flash/.
/*-preview*.png
